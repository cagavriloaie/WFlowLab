/* ============================================
 * WStreamLab Application Stylesheet
 * ============================================
 * Common styles for all dialogs and windows
 *
 * NOTE: Colors defined here correspond to AppColors namespace in colors.h
 * When changing colors, update both files to maintain consistency.
 * ============================================ */

/* Common styles */
* {
    font-family: Verdana, Arial, sans-serif;
    font-size: 12pt;
}

/* Common border style */
.common-border {
    border: 2px solid #ADD8E6;  /* AppColors::Border */
    border-radius: 4px;
}

/* QPushButton */
QPushButton {
    padding: 5px 10px;
    border: 2px solid #ccc;        /* AppColors::BorderStandard */
    background-color: #f0f0f0;     /* AppColors::BackgroundLight */
    border-radius: 5px;
}

QPushButton:hover {
    background-color: #d7d9d7;     /* AppColors::BackgroundHover */
    border: 2px solid #aaa;        /* AppColors::BorderHover */
}

QPushButton:focus {
    border: 2px solid #0078D7;     /* AppColors::Primary */
    outline: none;
}

/* QGroupBox */
QGroupBox {
    border: 2px solid rgba(0, 0, 0, 0.36);  /* AppColors::BorderGroupBox */
    background-color: #E6E6FF;              /* AppColors::BackgroundGroupBox */
    margin-top: 10px;
    padding-top: 10px;
}

/* QGroupBox Title */
QGroupBox::title {
    subcontrol-origin: margin;
    left: 7px;
    padding: 5px;
}

/* QRadioButton */
QRadioButton {
    spacing: 5px;
}

QRadioButton::indicator {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #f0f0f0;     /* AppColors::BackgroundLight */
    border: 1px solid #ADD8E6;     /* AppColors::Border */
}

QRadioButton::indicator:checked {
    background-color: #ADD8E6;     /* AppColors::Border */
    border: 1px solid #0078D7;     /* AppColors::Primary */
}

QRadioButton::indicator:unchecked {
    background-color: #f0f0f0;     /* AppColors::BackgroundLight */
    border: 1px solid #ADD8E6;     /* AppColors::Border */
}

QRadioButton:focus {
    outline: 1px dotted #0078D7;   /* AppColors::Primary */
}

QRadioButton:disabled {
    color: gray;
}

QRadioButton::indicator:disabled {
    background-color: lightgray;
}

/* Menu Bar */
QMenuBar {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
}

/* Base Menu */
QMenu {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    padding: 4px;
}

/* Menu Item */
QMenu::item {
    background-color: transparent;
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #d7d9d7;
}

/* Disabled Menu Item */
QMenu::item:disabled {
    color: #999;
}

/* Separator */
QMenu::separator {
    height: 1px;
    background-color: #ccc;
    margin: 4px 0;
}

/* Action */
QMenuBar::item,
QMenu::item {
    background: transparent;
    padding: 4px 10px;
    color: black;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background: #f0f0f0;
    color: black;
    border-radius: 4px;
}

QMenuBar::item:pressed,
QMenu::item:pressed {
    background-color: #d7d9d7;
    border-radius: 4px;
}

/* QComboBox */
QComboBox {
    border: 2px solid #ADD8E6;
    border-radius: 4px;
    padding: 2px;
    min-height: 20px;
    background-color: #f0f0f0;
    padding-right: 20px;
}

/* QComboBox Dropdown */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #ADD8E6;
}

/* Dropdown Arrow */
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox:focus {
    border: 2px solid #0078D7;
}

/* QLineEdit */
QLineEdit {
    border: 2px solid #ADD8E6;
    border-radius: 4px;
    height: 28px;
    padding: 2px;
    background-color: #f0f0f0;
}

QLineEdit:focus {
    border: 2px solid #0078D7;
}

/* Error and success states for QLineEdit */
QLineEdit[state="error"] {
    color: red;                             /* AppColors::Error / TextError */
}

QLineEdit[state="success"] {
    background-color: rgb(220, 235, 220);   /* AppColors::Success */
}

QLineEdit[readOnly="true"][state="success"] {
    background-color: rgb(220, 235, 220);   /* AppColors::Success */
}
