/* ============================================
 * WStreamLab Application Stylesheet
 * ============================================
 * Common styles for all dialogs and windows
 *
 * NOTE: Colors defined here correspond to AppColors namespace in colors.h
 * When changing colors, update both files to maintain consistency.
 * ============================================ */

/* Common styles */
* {
    font-family: Verdana, Arial, sans-serif;
    font-size: 12pt;
}

/* Water meter type label - smaller font to fit long names */
QLabel#lbTab1 {
    font-size: 9pt;
    font-weight: bold;
    color: #0078D7;  /* AppColors::Primary */
}

/* Common border style */
.common-border {
    border: 2px solid #ADD8E6;  /* AppColors::Border */
    border-radius: 4px;
}

/* QPushButton - Extra compact with optimal gray/white combination */
QPushButton {
    min-height: 20px;              /* Even shorter/extra compact */
    padding: 3px 12px;             /* Minimal vertical padding */
    border: 1px solid #5a6268;     /* Dark gray border */
    background-color: #6c757d;     /* Medium-dark gray background */
    color: #ffffff;                /* White text for contrast */
    border-radius: 4px;            /* Modern radius */
    font-weight: 500;              /* Slightly bold for readability */
}

QPushButton:hover {
    background-color: #5a6268;     /* Darker gray on hover */
    border: 1px solid #495057;     /* Even darker border on hover */
    color: #ffffff;                /* Keep white text */
}

QPushButton:focus {
    border: 1px solid #0078D7;     /* Blue focus indicator */
    outline: none;
}

QPushButton:disabled {
    background-color: #adb5bd;     /* Light gray when disabled */
    color: #e9ecef;                /* Faded white text */
    border: 1px solid #ced4da;
}

/* QGroupBox */
QGroupBox {
    border: 2px solid rgba(0, 0, 0, 0.36);  /* AppColors::BorderGroupBox */
    background-color: #F0F0FF;              /* Lighter background */
    margin-top: 18px;                       /* Extra space for badge title */
    padding-top: 10px;
    border-radius: 6px;
}

/* QGroupBox Title - Badge Style */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;                            /* Align nicely at left */
    top: 8px;                              /* Position from top */
    padding: 2px 8px;                      /* Compact padding */
    background-color: #0078D7;             /* Blue primary color */
    color: white;                          /* White text */
    border-radius: 4px;                    /* Rounded corners */
    font-weight: bold;                     /* Bold text */
    font-size: 8pt;                        /* Smaller compact font */
}

/* QRadioButton */
QRadioButton {
    spacing: 5px;
}

QRadioButton::indicator {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #f0f0f0;     /* AppColors::BackgroundLight */
    border: 1px solid #ADD8E6;     /* AppColors::Border */
}

QRadioButton::indicator:checked {
    background-color: #ADD8E6;     /* AppColors::Border */
    border: 1px solid #0078D7;     /* AppColors::Primary */
}

QRadioButton::indicator:unchecked {
    background-color: #f0f0f0;     /* AppColors::BackgroundLight */
    border: 1px solid #ADD8E6;     /* AppColors::Border */
}

QRadioButton:focus {
    outline: 1px dotted #0078D7;   /* AppColors::Primary */
}

QRadioButton:disabled {
    color: gray;
}

QRadioButton::indicator:disabled {
    background-color: lightgray;
}

/* Menu Bar */
QMenuBar {
    background-color: #E8F4F8;              /* Same as status bar */
    border: 1px solid #ccc;
}

/* Base Menu */
QMenu {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    padding: 4px;
}

/* Menu Item */
QMenu::item {
    background-color: transparent;
    padding: 4px 24px;
}

QMenu::item:selected {
    background-color: #d7d9d7;
}

/* Disabled Menu Item */
QMenu::item:disabled {
    color: #999;
}

/* Separator */
QMenu::separator {
    height: 1px;
    background-color: #ccc;
    margin: 4px 0;
}

/* Action */
QMenuBar::item,
QMenu::item {
    background: transparent;
    padding: 4px 10px;
    color: black;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background: #f0f0f0;
    color: black;
    border-radius: 4px;
}

QMenuBar::item:pressed,
QMenu::item:pressed {
    background-color: #d7d9d7;
    border-radius: 4px;
}

/* QComboBox */
QComboBox {
    border: 2px solid #ADD8E6;
    border-radius: 4px;
    padding: 2px;
    min-height: 20px;
    background-color: #f0f0f0;
    padding-right: 20px;
}

/* QComboBox Dropdown */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 2px solid #ADD8E6;
}

/* Dropdown Arrow */
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox:focus {
    border: 2px solid #0078D7;
}

/* QLineEdit */
QLineEdit {
    border: 2px solid #ADD8E6;
    border-radius: 4px;
    height: 28px;
    padding: 2px;
    background-color: #f0f0f0;
}

QLineEdit:focus {
    border: 2px solid #0078D7;
}

/* Error and success states for QLineEdit */
QLineEdit[state="error"] {
    color: red;                             /* AppColors::Error / TextError */
}

QLineEdit[state="success"] {
    background-color: rgb(220, 235, 220);   /* AppColors::Success */
}

QLineEdit[readOnly="true"][state="success"] {
    background-color: rgb(220, 235, 220);   /* AppColors::Success */
}

/* QStatusBar */
QStatusBar {
    background-color: #E8F4F8;              /* Light blue background */
    color: #000000;                         /* Black text */
    padding: 2px;
}

QStatusBar::item {
    border: none;
}
